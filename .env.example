PORT=3020
# Public HTTPS origin; the connector URL is ${PUBLIC_URL}/mcp
PUBLIC_URL=https://mcp-kaderisasi.salmanitb.com
# Random secret, at least 32 chars (openssl rand -hex 32). Rotating it signs everyone out.
MCP_SIGNING_KEY=
# Same Google OAuth client as the admin dashboard (VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
MCP_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com
# The read-only kaderisasi_mcp user from sql/grant-readonly.sql, never the owner
DB_HOST=
DB_PORT=5432
DB_USER=kaderisasi_mcp
DB_PASSWORD=
DB_DATABASE=
DB_SSL=false
DB_SCHEMA=public
QUERY_TIMEOUT_MS=15000
QUERY_MAX_ROWS=1000
