PORT=3020
# The one key that unlocks the connector (openssl rand -hex 32).
# Connector URL: https://<host>/mcp/<MCP_API_KEY>
MCP_API_KEY=
# The read-only kaderisasi_mcp user from sql/grant-readonly.sql, never the owner
DB_HOST=
DB_PORT=5432
DB_USER=kaderisasi_mcp
DB_PASSWORD=
DB_DATABASE=
DB_SSL=false
DB_SCHEMA=public
QUERY_TIMEOUT_MS=15000
QUERY_MAX_ROWS=1000
