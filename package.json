{
  "name": "kaderisasi-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server over the Kaderisasi PostgreSQL database, for a Claude custom connector",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "node --test test/unit.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:flow": "node --test test/flow.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
